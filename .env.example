# ══════════════════════════════════════════════════════════════════════════════
# Helix Finance AI — Environment Variables Template
# Copy this file to .env and fill in your local values.
# ══════════════════════════════════════════════════════════════════════════════

# ── App ───────────────────────────────────────────────────────────────────────
APP_NAME="Helix Finance AI"
APP_VERSION="0.1.0"
APP_ENV="development"           # development | staging | production
DEBUG=true
LOG_LEVEL="INFO"

# ── API ───────────────────────────────────────────────────────────────────────
API_HOST="0.0.0.0"
API_PORT=8000
API_PREFIX="/api/v1"

# ── Security ──────────────────────────────────────────────────────────────────
SECRET_KEY="CHANGE_ME_super_secret_key_at_least_32_chars"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ── Rate Limiting ─────────────────────────────────────────────────────────────
RATE_LIMIT_REQUESTS=100         # requests per window
RATE_LIMIT_WINDOW=60            # seconds

# ── PostgreSQL ────────────────────────────────────────────────────────────────
POSTGRES_HOST="localhost"
POSTGRES_PORT=5432
POSTGRES_DB="helix_finance"
POSTGRES_USER="helix_user"
POSTGRES_PASSWORD="helix_pass"
DATABASE_URL="postgresql+asyncpg://helix_user:helix_pass@localhost:5432/helix_finance"

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_HOST="localhost"
REDIS_PORT=6379
REDIS_DB=0
REDIS_URL="redis://localhost:6379/0"

# ── Qdrant ────────────────────────────────────────────────────────────────────
QDRANT_HOST="localhost"
QDRANT_PORT=6333
QDRANT_COLLECTION="helix_docs"
QDRANT_API_KEY=""               # leave empty for local

# ── MinIO ─────────────────────────────────────────────────────────────────────
MINIO_ENDPOINT="localhost:9000"
MINIO_ACCESS_KEY="minioadmin"
MINIO_SECRET_KEY="minioadmin"
MINIO_BUCKET="helix-documents"
MINIO_SECURE=false

# ── RabbitMQ ──────────────────────────────────────────────────────────────────
RABBITMQ_HOST="localhost"
RABBITMQ_PORT=5672
RABBITMQ_USER="guest"
RABBITMQ_PASS="guest"
CELERY_BROKER_URL="amqp://guest:guest@localhost:5672//"
CELERY_RESULT_BACKEND="redis://localhost:6379/1"

# ── LLM / LiteLLM ────────────────────────────────────────────────────────────
LITELLM_MODEL="ollama/llama3"   # swap to openai/gpt-4o for production
LITELLM_BASE_URL="http://localhost:11434"
OPENAI_API_KEY=""               # optional: set for OpenAI fallback

# ── Embeddings ────────────────────────────────────────────────────────────────
EMBEDDING_MODEL="BAAI/bge-small-en-v1.5"
EMBEDDING_DIMENSION=384

# ── Langfuse (LLM Observability) ──────────────────────────────────────────────
LANGFUSE_SECRET_KEY=""
LANGFUSE_PUBLIC_KEY=""
LANGFUSE_HOST="http://localhost:3000"

# ── Prometheus ────────────────────────────────────────────────────────────────
PROMETHEUS_ENABLED=true
METRICS_PATH="/metrics"
